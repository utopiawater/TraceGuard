# =========================================================
# TraceGuard Git Ignore
# =========================================================


# ---------------------------------------------------------
# Python
# ---------------------------------------------------------

__pycache__/
*.py[cod]
*$py.class

.pytest_cache/
.pytest-*/
.tmp-*/
.mypy_cache/
.ruff_cache/
.cache/

*.egg-info/
.eggs/

build/
dist/


# ---------------------------------------------------------
# Python virtual environments
# ---------------------------------------------------------

.venv/
.venv*/
venv/
env/
ENV/

.conda/


# ---------------------------------------------------------
# Environment variables / secrets
# ---------------------------------------------------------

.env
.env.local
.env.development
.env.production
.env.test

# 注意：保留模板
!.env.example


# ---------------------------------------------------------
# Frontend / Node.js
# ---------------------------------------------------------

node_modules/

frontend/node_modules/
frontend/dist/

*.tsbuildinfo

npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*


# ---------------------------------------------------------
# Database runtime files
# ---------------------------------------------------------

*.db
*.db-shm
*.db-wal

*.sqlite
*.sqlite3


# ---------------------------------------------------------
# Runtime dependencies
# Neo4j 等本地运行环境不要上传
# ---------------------------------------------------------

.runtime/


# ---------------------------------------------------------
# Raw security datasets / logs / captures
# ---------------------------------------------------------

data/raw/*
data/reports/*
data/analysis_tasks/*
data/dataset_*/raw/*
data/dataset_*/reports/*
data/dataset_e3_generalization/
data/test_tmp_*/
data/self_check_tmp/
data/pytest_tmp/
data/pytest_truth_run*/
data/manual_generalization_checks*/
data/testbed_analysis/
data/testbed_bundles/
data/testbed_dry_run_tmp/
data/testbed_upload_analysis/
data/testbed_upload_analysis_final/

# 如果以后需要保留空目录，可以放 .gitkeep
!data/raw/.gitkeep
!data/reports/.gitkeep

*.pcap
*.pcapng
*.cap

*.log
!backend/fixtures/scenarios/**/*.log
!backend/fixtures/collectors/**/*.log


# ---------------------------------------------------------
# Dataset files
# README 可以上传，实际大型数据集不要上传
# ---------------------------------------------------------

datasets/*
!datasets/
!datasets/README.md
!datasets/sample_attack_dataset.json
!datasets/**/
!datasets/**/README.md
!datasets/**/sample*.json
datasets/darpa_tc_e3_cadets/processed_dataset/*
datasets/darpa_tc_e3_cadets/source_metadata/*


# ---------------------------------------------------------
# Generated output
# ---------------------------------------------------------

reports/
output/
outputs/
temp/
tmp/


# ---------------------------------------------------------
# Large model / binary files
# ---------------------------------------------------------

*.pt
*.pth
*.ckpt
*.onnx
*.bin


# ---------------------------------------------------------
# Archives
# ---------------------------------------------------------

*.zip
*.rar
*.7z
*.tar
*.tar.gz


# ---------------------------------------------------------
# Course / reference materials
# 不作为项目源代码上传
# ---------------------------------------------------------

2026网络空间安全课程设计-new(1).pdf
17组-邵逸楠-2023212160.zip


# ---------------------------------------------------------
# IDE
# ---------------------------------------------------------

.vscode/
.idea/


# ---------------------------------------------------------
# Operating system
# ---------------------------------------------------------

.DS_Store
Thumbs.db
desktop.ini
