TRACEGUARD_MODE=replay
# Windows 本地运行使用项目内相对路径；Docker Compose 会覆盖为 /data。
TRACEGUARD_DATA_DIR=data
TRACEGUARD_DATABASE_PATH=data/traceguard.db
TRACEGUARD_RAW_ARCHIVE_DIR=data/raw
NEO4J_PASSWORD=change-this-for-local-lab
TRACEGUARD_NEO4J_URI=bolt://neo4j:7687
TRACEGUARD_NEO4J_USER=neo4j
TRACEGUARD_NEO4J_PASSWORD=change-this-for-local-lab
# 真实 LLM 使用 OpenAI-compatible Chat Completions 接口。
# API Key 只写入本地 .env；不得提交、打印或通过 API/前端返回。
TRACEGUARD_REPORT_DIR=data/reports
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=180

# Live run 只读取 N9 本地可见路径；多个路径用英文分号分隔。
TRACEGUARD_LIVE_POLL_INTERVAL_SECONDS=2
TRACEGUARD_LIVE_MICRO_BATCH_SIZE=50
TRACEGUARD_LIVE_REPLAY_PATH=
TRACEGUARD_WAZUH_JSONL_PATHS=
TRACEGUARD_ZEEK_LOG_ROOTS=
